; Engine configuration file.
; Prefer editing through the Godot editor when changing engine settings.

config_version=5

[application]

config/name="Imperialism Modern Viewer"
run/main_scene="res://Main.tscn"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Imperialism.Client"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.043, 0.055, 1)
